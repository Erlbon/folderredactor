#!/bin/sh
# Test gate, from the Veritas repo's pre-push (2026-10-02) as the Redactor family runs it: the whole test suite must
# pass before anything is pushed. Uses pytest's own exit code (never piped into tail). Qt runs offscreen so no window
# is needed. A one-off Windows file-lock failure has happened in the siblings; rerun before assuming the code is broken.
# Emergency bypass for a docs-only push: git push --no-verify (say why in the commit message).
QT_QPA_PLATFORM=offscreen python -m pytest -q -p no:cacheprovider || { echo "pre-push: the tests fail; not pushing" >&2; exit 1; }
exit 0
